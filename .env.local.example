# Copy this to .env.local (gitignored) and fill in your Supabase project's
# values from Project Settings → Data API.
#
# Both are client-safe — see the comment in .env.local for why.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Stripe — Developers → API keys (sandbox/test mode). This one is a real
# secret, unlike the two above — never prefix it NEXT_PUBLIC_.
STRIPE_SECRET_KEY=

# From `stripe listen` (local dev) or a Dashboard webhook endpoint (deployed).
STRIPE_WEBHOOK_SECRET=

NEXT_PUBLIC_SITE_URL=http://localhost:4321

# Secret required by /api/members/expiry-reminders. Use a long random value
# in production and send it as `Authorization: Bearer <value>` from the
# scheduler/cron job.
CRON_SECRET=

# Gmail SMTP — needs 2-Step Verification + an App Password, not the regular
# account password. Server-only, same rule as the Stripe secret above.
GMAIL_USER=
GMAIL_APP_PASSWORD=
